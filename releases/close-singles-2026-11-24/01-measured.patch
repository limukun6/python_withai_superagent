+++ b/superagent/ab_close_singles.py
@@ -0,0 +1,91 @@
+"""Use spare budget to check a statistically close single when no pair warranted confirmation."""
+import numpy as np
+
+from .ab_adaptive_opening import opening_uncertainty
+from .ab_complement import MIN_GAIN, split_columns
+from .ab_scheduler import CONFIRMATIONS, PRIMARY, _action
+from .metrics import MetricSpec
+
+
+def close_challenger(opening, anchor, labels, groups):
+    anchor_hits = opening[anchor][0] == labels
+    eligible = []
+    for name, record in opening.items():
+        gains = int(np.sum((record[0] == labels) & ~anchor_hits))
+        if not gains:
+            continue
+        pair = {anchor: opening[anchor], name: record}
+        uncertainty = opening_uncertainty(pair, labels, groups)
+        if uncertainty['ambiguous']:
+            correct = int(np.sum(record[0] == labels))
+            eligible.append((-gains, -correct, name, uncertainty))
+    if eligible:
+        negative_gains, _, candidate, uncertainty = min(eligible, key=lambda row: row[:3])
+        return dict(challenger=candidate, corrections=-negative_gains, gap=uncertainty['gap'],
+                    cluster_standard_error=uncertainty['cluster_standard_error'])
+
+
+class SingleConfirmationPolicy:
+    def __init__(self, base):
+        self.base = base
+
+    def review(self, state, trusted):
+        evidence = self.base.review(state, trusted)
+        split = CONFIRMATIONS[0]
+        if evidence.get('comparison_members') or split not in state['registered_confirmation_splits']:
+            return evidence
+        anchor = evidence['anchor']
+        metric = MetricSpec.from_payload({'metric_spec':state['task']['metric']})
+        y, _, opening = split_columns(state, trusted, PRIMARY, metric)
+        check = close_challenger(opening, anchor, y, trusted[PRIMARY]['groups'])
+        if check is None:
+            return evidence
+        first_groups = set(trusted[PRIMARY]['groups'])
+        fresh = np.array([g not in first_groups for g in trusted[split]['groups']], dtype=bool)
+        fresh_rows = int(fresh.sum())
+        check.update(anchor=anchor, fresh_rows=fresh_rows)
+        evidence['close_singles'] = check
+        if not fresh_rows:
+            check['status'] = 'no_fresh_groups'
+            return evidence
+        candidate = check['challenger']
+        confirmed_y, _, records = split_columns(state, trusted, split, metric)
+        missing = [name for name in (anchor, candidate) if name not in records]
+        evidence['evidence_trials'].extend(records[name][2] for name in (anchor,candidate) if name in records)
+        if missing:
+            budget = state['budget']
+            if len(missing) + budget['reserved_final_refit'] > budget['remaining_fit_allowance']:
+                check['status'] = 'retain_budget'
+            else:
+                check['status'] = 'collect'
+                evidence['pending'] = missing
+            return evidence
+        first_correct = evidence['opening_correct']
+        fresh_correct = {name:int(np.sum(records[name][0][fresh] == confirmed_y[fresh])) for name in (anchor,candidate)}
+        fresh_net = fresh_correct[candidate]-fresh_correct[anchor]
+        total = len(y) + fresh_rows
+        pooled_gain = (first_correct[candidate]-first_correct[anchor]+fresh_net)/total
+        switch = fresh_net > 0 and pooled_gain >= MIN_GAIN
+        winner = candidate if switch else anchor
+        check.update(status='switch' if switch else 'retain', fresh_correct=fresh_correct,
+                     fresh_net=fresh_net, distinct_rows=total, pooled_gain=pooled_gain)
+        evidence.update(members=[winner], confirmation_rows=fresh_rows,
+                        portfolio_score=(first_correct[winner]+fresh_correct[winner])/total)
+        return evidence
+
+    def action(self, state, capabilities, trusted, **options):
+        original = self.base.action(state, capabilities, trusted, **options)
+        if original['action'] != 'stop' or sum(r['split_id']==PRIMARY for r in state['history']) < 4:
+            return original
+        evidence = self.review(state, trusted)
+        check = evidence.get('close_singles')
+        if not check:
+            return original
+        if check['status'] == 'collect':
+            return _action('confirm','Check both close singles on the same registered confirmation split.',
+                           evidence['evidence_trials'],evidence['pending'][0],CONFIRMATIONS[0],1)
+        reasons = dict(switch='The challenger gained on fresh groups and across the combined distinct rows.',
+                       retain='The fresh comparison did not warrant replacing the opening leader.',
+                       retain_budget='Retain the leader and reserve enough fits for final training.',
+                       no_fresh_groups='The registered confirmation offers no new groups.')
+        return _action('stop',reasons[check['status']],evidence['evidence_trials'])
